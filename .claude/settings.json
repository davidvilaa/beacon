{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(npm run dev:*)",
      "Bash(next dev:*)",
      "Bash(npx next dev:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
